# Define lattice and region
lattice diamond 5.431
Lattice spacing in x,y,z = 5.431 5.431 5.431
region box block 0 10 0 10 0 10
create_box 1 box
Created orthogonal box = (0 0 0) to (54.31 54.31 54.31)
  1 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 8000 atoms
  using lattice units in orthogonal box = (0 0 0) to (54.31 54.31 54.31)
  create_atoms CPU = 0.000 seconds

# Set KIM interactions
kim interactions Si
#=== BEGIN kim interactions ==================================
pair_style kim SW_StillingerWeber_1985_Si__MO_405512056662_005
pair_coeff * * Si
#=== END kim interactions ====================================


# Define mass for Silicon
mass 1 28.0855

# Neighbor settings
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# Define simulation settings
timestep 0.001
thermo 100

# Set initial velocity and run
velocity all create 300.0 12345
fix 1 all nvt temp 300.0 300.0 0.1

# Run the simulation
run 10000

