# KIM Lennard-Jones test simulation for testing purposes
# This is a minimal, fast-running simulation using KIM potentials

# Install model if needed: kim-api-collections-management install user LJ_Shifted_Bernardes_1958MedCutoff_Ar__MO_126566794224_004

units           metal
dimension       3
boundary        p p p

# KIM initialization (BEFORE create_box)
kim init LJ_Shifted_Bernardes_1958MedCutoff_Ar__MO_126566794224_004 metal

lattice         fcc 5.26
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box

# KIM interactions (AFTER create_box)
kim interactions Ar

# Mass definition (REQUIRED even with KIM)
mass            1 39.948

neighbor        2.0 bin
neigh_modify    delay 0 every 20 check no

fix             1 all nve

thermo          5
thermo_style    custom step temp press pe ke etotal vol density

dump            1 all atom 25 dump.atom

timestep        0.001
run             50
