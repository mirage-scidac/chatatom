# Test script for KIM potential with Argon
# This tests if LAMMPS has KIM package properly installed

units metal
dimension 3
boundary p p p

# KIM potential initialization MUST come before create_box
# Using a well-known Lennard-Jones potential for Argon from OpenKIM
kim init LJ_Shifted_Bernardes_1958MedCutoff_Ar__MO_126566794224_004 metal

lattice fcc 5.26
region box block 0 3 0 3 0 3
create_box 1 box
create_atoms 1 box

# Set up KIM interactions after create_box
kim interactions Ar

# Set mass for argon (KIM doesn't automatically set masses)
mass 1 39.948

neighbor 2.0 bin
neigh_modify delay 0 every 20 check no

fix 1 all nve

thermo 10
thermo_style custom step temp press pe ke etotal vol density

dump 1 all atom 50 dump.atom

timestep 0.001
run 50
